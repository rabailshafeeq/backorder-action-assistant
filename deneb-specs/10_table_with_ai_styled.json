              "as": "RevenueLabel"
            },
            {
              "calculate": "datum.MRPReviewed_Flag",
              "as": "ReviewedLabel"
            },
            {
              "calculate": "'Plant ' + datum.Plant",
              "as": "PlantLabel"
            },
            {
              "calculate": "datum.PriorityTier == 'Critical' ? '#D64545' : datum.PriorityTier == 'High' ? '#E8724C' : datum.PriorityTier == 'Medium' ? '#E0A62E' : '#5C8A6E'",
